# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# AUTH_SECRET: Cryptographic HMAC secret for signing session tokens.
AUTH_SECRET="MY_CRYPTOGRAPHIC_AUTH_SECRET"

# FIREBASE_PROJECT_ID: Provisioned Firestore & Firebase Authentication project ID.
FIREBASE_PROJECT_ID="gen-lang-client-0302319208"
VITE_FIREBASE_PROJECT_ID=""
VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_APP_ID=""
VITE_FIREBASE_AUTH_DOMAIN=""
VITE_FIREBASE_STORAGE_BUCKET=""
VITE_FIREBASE_MESSAGING_SENDER_ID="1074828390225"
VITE_FIREBASE_FIRESTORE_DATABASE_ID=""

# OAUTH_CLIENT_ID: Google OAuth 2.0 / OpenID Connect client identifier.
OAUTH_CLIENT_ID="MY_GOOGLE_OAUTH_CLIENT_ID"

# VITE_GOOGLE_MAPS_API_KEY: Required for Google Maps Platform.
VITE_GOOGLE_MAPS_API_KEY="MY_GOOGLE_MAPS_API_KEY"
